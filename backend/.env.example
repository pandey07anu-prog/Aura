# ==========================================================
# Aura Finance - Backend Environment Variables Configuration
# ==========================================================

# 1. MongoDB Database Settings
# For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/expensetracker
MONGODB_DATABASE=expensetracker

# For MongoDB Atlas Cloud Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/expensetracker?retryWrites=true&w=majority
# MONGODB_DATABASE=expensetracker

# 2. JWT Security
# 256-bit hexadecimal or Base64 secret key
JWT_SECRET=9a4f2c8d3b7a1e6f5c8b2d4e7a9c1f3b5e7d9a1c3e5b7d9a1c3e5b7d9a1c3e5b
# Token lifetime in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# 3. SMTP Mail Configuration (Spring Mail)
# In development, leave MAIL_ENABLED=false (emails will log mock notifications to console)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=noreply@aurafinance.com

# 4. Web Application Base URL & CORS (for email links, password reset links, CORS verification)
APP_BASE_URL=http://localhost:5173
# Additional allowed origins (comma-separated, e.g. https://aurafinance.vercel.app,https://mycustomdomain.com)
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://aurafinance.vercel.app

# 5. Bootstrap Administrator Account (Auto-provisioned on initial boot if no admin exists)
ADMIN_DEFAULT_EMAIL=admin@aurafinance.com
ADMIN_DEFAULT_PASSWORD=Admin@123456
